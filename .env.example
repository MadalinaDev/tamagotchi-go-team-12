# Copy to .env and replace every value. Never commit .env.
# Use letters, digits and underscores only (passwords end up in SQL and connection URLs).

# Postgres superuser (used only by the postgres container and db/init)
POSTGRES_PASSWORD=change_me
# Host port for Postgres; change it if 5432 is already taken on your machine
POSTGRES_HOST_PORT=5432

# One database user per service, created by db/init/01-create-databases.sh
BATTLE_DB_PASSWORD=change_me
TAMAGOTCHI_DB_PASSWORD=change_me
GUILD_DB_PASSWORD=change_me
NOTIFICATION_DB_PASSWORD=change_me
USER_MANAGEMENT_DB_PASSWORD=change_me
MAP_DB_PASSWORD=change_me
RAID_DB_PASSWORD=change_me
REGISTRY_DB_PASSWORD=change_me

# Lab 2: Gateway downstream secret (must match GATEWAY_SECRET in every migrated service)
GATEWAY_SECRET=change_me
# Lab 2: interim admin-role bridge (seed admin ID); remove with issuer role claims
GATEWAY_ADMIN_USER_IDS=00000000-0000-4000-8000-000000000009
# Lab 2: per-service tokens the Gateway maps to X-Service-Name (used by migrated services)
BATTLE_SERVICE_TOKEN=change_me
TAMAGOTCHI_SERVICE_TOKEN=change_me
GUILD_SERVICE_TOKEN=change_me
NOTIFICATION_SERVICE_TOKEN=change_me
USER_MANAGEMENT_SERVICE_TOKEN=change_me
MAP_SERVICE_TOKEN=change_me
RAID_SERVICE_TOKEN=change_me
REGISTRY_SERVICE_TOKEN=change_me
