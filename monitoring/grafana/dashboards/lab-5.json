    {
      "type": "timeseries",
      "title": "Gateway cache hit ratio",
      "description": "Cached GET responses and verified tokens found in the cache, of all lookups.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (rate(gateway_cache_lookups_total{result=\"hit\"}[1m])) / sum by (kind) (rate(gateway_cache_lookups_total{result=~\"hit|miss\"}[1m]))",
