        {
          "name": "Create an already-ended raid (dev)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Request-Id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code < 300) pm.collectionVariables.set('ended_raid_id', pm.response.json().raid_id);",
                  "pm.test('created as failed (late activation)', () => pm.expect(pm.response.json().state).to.eql('failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              }
            ],
            "url": "{{base_url}}/internal/v1/dev/raid-events",
            "description": "Activation two hours after starts_at (Big Slime lasts 3600 s): the raid is created directly as failed, so its event stream ends right after the snapshot.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{$guid}}\",\n  \"type\": \"RaidActivationRequested\",\n  \"version\": 1,\n  \"producer\": \"package-registry\",\n  \"occurred_at\": \"{{two_hours_ago}}\",\n  \"correlation_id\": \"{{ended_schedule_id}}\",\n  \"payload\": {\n    \"schedule_id\": \"{{ended_schedule_id}}\",\n    \"revision\": 1,\n    \"definition_id\": \"{{definition_id}}\",\n    \"definition_version\": 1,\n    \"guild_id\": \"{{guild_id}}\",\n    \"starts_at\": \"{{two_hours_ago}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Raid event stream (ended raid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Request-Id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('text/event-stream', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream'));",
                  "pm.test('one raid snapshot, then the stream ends', () => { const body = pm.response.text(); pm.expect(body).to.include('event: raid'); pm.expect(body).to.include('\"state\":\"failed\"'); pm.expect(body).to.include(pm.collectionVariables.get('ended_raid_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{alice_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/raids/{{ended_raid_id}}/events",
            "description": "Server-sent events: `raid` (snapshot and every state change), `attack` (every accepted attack with remaining_hp) and `ping` every 15 s. The stream ends once the raid is completed, failed or cancelled."
          }
        },
        {
          "name": "Raid event stream (not a member)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('X-Request-Id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('status 403 before any stream is opened', () => pm.response.to.have.status(403));",
                  "pm.test('JSON error envelope', () => { const b = pm.response.json(); pm.expect(b.code).to.eql('RAID_FORBIDDEN'); pm.expect(b.request_id).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{outsider_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/raids/{{raid_id}}/events",
            "description": "Same access rule as GET /api/v1/raids/{raid_id}: refused callers get a normal JSON error, not a stream."
          }
        }
      ]
    }
  ]
}
