        {
          "name": "Raid created from the activation event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tries = Number(pm.collectionVariables.get('poll_tries') || 0);",
                  "if (!(pm.response.code === 200) && tries < 40) {",
                  "  pm.collectionVariables.set('poll_tries', String(tries + 1));",
                  "  setTimeout(() => {}, 250);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset('poll_tries');",
                  "  pm.test('the raid exists (created from the event)', () => pm.response.to.have.status(200));",
                  "  if (pm.response.code === 200) pm.collectionVariables.set('raid_id', pm.response.json().raid_id);",
                  "  pm.test('active with full HP', () => { const b = pm.response.json(); pm.expect(b.state).to.eql('active'); pm.expect(b.hp).to.eql(b.max_hp); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{service_token}}"
              }
            ],
            "url": "{{broker_url}}/internal/v1/raids/by-schedule/{{schedule_id}}",
            "description": "Repeated every 250 ms (at most 10 s) until Monster Raid has consumed the activation event: 404 before, 200 Raid after."
