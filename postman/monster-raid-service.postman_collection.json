                  "if (pm.response.code < 300) pm.collectionVariables.set('raid_id', pm.response.json().raid_id);",
                  "pm.test('active with full HP', () => { const b = pm.response.json(); pm.expect(b.state).to.eql('active'); pm.expect(b.hp).to.eql(b.max_hp); });"
                ]
