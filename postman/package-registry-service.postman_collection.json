{
  "info": {
    "name": "Package Registry (Lab 1)",
    "description": "tamagotchi-package-registry-service:0.1.0 on port 8088. Public routes send X-Mock-User-Id (Alice by default; admin routes add X-Mock-Roles: admin). Internal routes send X-Service-Name. Run top to bottom: later requests reuse ids saved by earlier ones. Package names get a per-run suffix so the collection can be re-run on the same database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8088"
    },
    {
      "key": "user_id",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "admin_id",
      "value": "00000000-0000-4000-8000-000000000009"
    },
    {
      "key": "bob_id",
      "value": "00000000-0000-4000-8000-000000000002"
    },
    {
      "key": "guild_id",
      "value": "00000000-0000-4000-8000-0000000000c1"
    },
    {
      "key": "run_id",
      "value": ""
    },
    {
      "key": "package_id",
      "value": ""
    },
    {
      "key": "definition_id",
      "value": ""
    },
    {
      "key": "schedule_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('registry_base_url')) pm.collectionVariables.set('base_url', pm.environment.get('registry_base_url'));",
          "if (pm.info.requestName === 'Missing identity') pm.collectionVariables.set('run_id', String(Date.now()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Packages",
      "item": [
        {
          "name": "Missing identity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('X-Request-Id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "pm.test('error envelope', () => { const b = pm.response.json(); pm.expect(b.code).to.be.a('string'); pm.expect(b.request_id).to.be.a('string'); pm.expect(b.details).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/packages"
          }
        },
        {
          "name": "Create package (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('X-Request-Id header', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string').and.not.empty);",
                  "if (pm.response.code < 300) pm.collectionVariables.set('package_id', pm.response.json().package_id);",
                  "pm.test('definition v1', () => pm.expect(pm.response.json().current_definition_version).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Mock-User-Id",
                "value": "{{admin_id}}"
              },
              {
                "key": "X-Mock-Roles",
                "value": "admin"
              }
            ],
            "url": "{{base_url}}/api/v1/packages",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PetHub {{run_id}}\",\n  \"app_version\": \"1.0.0\",\n  \"description\": \"Pets with hunger and happiness\",\n  \"developer_id\": \"{{user_id}}\",\n  \"stats\": [\n    {\"key\": \"hunger\", \"min\": 0, \"max\": 100, \"initial\": 20, \"bonus_when\": \"lte\", \"threshold\": 20, \"combat_bonus\": 0.05},\n    {\"key\": \"happiness\", \"min\": 0, \"max\": 100, \"initial\": 80, \"bonus_when\": \"gte\", \"threshold\": 80, \"combat_bonus\": 0.1}\n  ],\n  \"sprite_urls\": [\"https://cdn.example.com/pethub/idle.png\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
