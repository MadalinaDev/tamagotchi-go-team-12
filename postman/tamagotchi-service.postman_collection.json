{"info":{"_postman_id":"t4magotchi-service-lab1","name":"tamagotchi-service (Lab 1)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"CRUD verification for Sava's tamagotchi-service. Set base_url and ids in collection variables, then run top to bottom."},"variable":[{"key":"base_url","value":"http://localhost:8082"},{"key":"user_id","value":"11111111-1111-4111-8111-111111111111"},{"key":"package_id","value":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"},{"key":"pet_id","value":""}],"item":[{"name":"Health","request":{"method":"GET","url":"{{base_url}}/health"}},{"name":"Tamagotchi types","request":{"method":"GET","url":"{{base_url}}/api/v1/tamagotchi-types"}},{"name":"Create tamagotchi","event":[{"listen":"test","script":{"exec":["pm.test('created', function () {","  pm.response.to.have.status(201);","  var body = pm.response.json();","  pm.collectionVariables.set('pet_id', body.pet_id);","});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis","body":{"mode":"raw","raw":"{\n  \"package_id\": \"{{package_id}}\",\n  \"name\": \"Ember\",\n  \"type\": \"flame\"\n}"}}},{"name":"List tamagotchis","request":{"method":"GET","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis"}},{"name":"Get tamagotchi","request":{"method":"GET","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis/{{pet_id}}"}},{"name":"Rename tamagotchi","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis/{{pet_id}}","body":{"mode":"raw","raw":"{\n  \"name\": \"Blaze\",\n  \"expected_version\": 1\n}"}}},{"name":"Get missing tamagotchi (expects 404)","request":{"method":"GET","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis/00000000-0000-4000-8000-000000000000"}},{"name":"Delete tamagotchi","request":{"method":"DELETE","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/tamagotchis/{{pet_id}}"}}]}
