{
  "info": {
    "name": "Tamagotchi service (Lab 2, via Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "pet_ember",
      "value": "00000000-0000-4000-8000-0000000000b1"
    },
    {
      "key": "pet_ripple",
      "value": "00000000-0000-4000-8000-0000000000b2"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('gateway_base_url')) pm.collectionVariables.set('base_url', pm.environment.get('gateway_base_url'));",
          "function uuidv4() { return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) { var r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); }); }",
          "pm.request.headers.upsert({key: 'Content-Type', value: 'application/json'});",
          "var publicRequests = ['Gateway health', 'Login Alice', 'Login Bob', 'Missing identity'];",
          "if (publicRequests.indexOf(pm.info.requestName) === -1) {",
          "    var m = pm.info.requestName.match(/^\\[(Alice|Bob)\\]/);",
          "    var tokenKey = (m && m[1] === 'Bob') ? 'token_bob' : 'token_alice';",
          "    pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get(tokenKey)});",
          "}",
          "var mutating = ['Create', 'Update', 'Decline', 'Accept', 'Cancel', 'Select', 'Rename'];",
          "if (mutating.some(function (k) { return pm.info.requestName.indexOf(k) !== -1; })) {",
          "    pm.request.headers.upsert({key: 'Idempotency-Key', value: uuidv4()});",
          "}",
          "if (pm.info.requestName === '[Alice] Select') {",
          "    pm.request.body.update({mode: 'raw', raw: JSON.stringify({primary_pet_id: '00000000-0000-4000-8000-0000000000b1', secondary_pet_id: '00000000-0000-4000-8000-0000000000b2', expected_version: Number(pm.collectionVariables.get('sel_version'))}), options: {raw: {language: 'json'}}});",
          "}",
          "if (pm.info.requestName === '[Alice] Rename') {",
          "    pm.request.body.update({mode: 'raw', raw: JSON.stringify({name: 'Ember', expected_version: Number(pm.collectionVariables.get('pet_version'))}), options: {raw: {language: 'json'}}});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var expected = {\"Gateway health\": 200, \"Login Alice\": 200, \"Login Bob\": 200, \"[Alice] Types\": 200, \"[Alice] List mine\": 200, \"[Alice] Get Ember\": 200, \"[Bob] Foreign pet redacted\": 200, \"[Alice] Get selection\": 200, \"[Alice] Select\": 200, \"[Alice] Rename\": 200, \"[Alice] Invalid ID\": 422, \"Missing identity\": 401};",
          "pm.test(pm.info.requestName + ' status', function () { pm.response.to.have.status(expected[pm.info.requestName]); });",
          "if (pm.response.code !== 204) { var b = pm.response.json();",
          "pm.test('Request ID returned', function () { pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[a-f0-9-]{36}$/); });",
          "if (pm.response.code >= 400) { pm.test('Structured error', function () { pm.expect(b.request_id).to.eql(pm.response.headers.get('X-Request-ID')); pm.expect(b.code).to.be.a('string'); }); }",
          "if (pm.info.requestName === 'Login Alice' && pm.response.code === 200) { pm.collectionVariables.set('token_alice', b.access_token); }",
          "if (pm.info.requestName === 'Login Bob' && pm.response.code === 200) { pm.collectionVariables.set('token_bob', b.access_token); }",
          "if (pm.info.requestName === '[Alice] List mine' && pm.response.code === 200) { pm.test('Seed pets present', function () { pm.expect(b.items.length).to.be.at.least(2); }); }",
          "if (pm.info.requestName === '[Alice] Get Ember' && pm.response.code === 200) { pm.collectionVariables.set('pet_version', b.version); pm.test('Owner sees care stats', function () { pm.expect(b.care_stats).to.be.an('object'); }); }",
          "if (pm.info.requestName === '[Bob] Foreign pet redacted' && pm.response.code === 200) { pm.test('Public view redacted', function () { pm.expect(b.care_stats).to.be.undefined; pm.expect(b).to.not.have.property('definition_version'); }); }",
          "if (pm.info.requestName === '[Alice] Get selection' && pm.response.code === 200) { pm.collectionVariables.set('sel_version', b.version); }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Gateway health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Login Alice",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@example.com\", \"password\": \"password123\"}"
        }
      }
    },
    {
      "name": "Login Bob",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"bob@example.com\", \"password\": \"password123\"}"
        }
      }
    },
    {
      "name": "[Alice] Types",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchi-types"
      }
    },
    {
      "name": "[Alice] List mine",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchis"
      }
    },
    {
      "name": "[Alice] Get Ember",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchis/{{pet_ember}}"
      }
    },
    {
      "name": "[Bob] Foreign pet redacted",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchis/{{pet_ember}}"
      }
    },
    {
      "name": "[Alice] Get selection",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchi-selections/me"
      }
    },
    {
      "name": "[Alice] Select",
      "request": {
        "method": "PUT",
        "url": "{{base_url}}/api/v1/tamagotchi-selections/me",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "[Alice] Rename",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/api/v1/tamagotchis/{{pet_ember}}",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "[Alice] Invalid ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchis/not-a-uuid"
      }
    },
    {
      "name": "Missing identity",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/v1/tamagotchis"
      }
    }
  ]
}
