          {
            "key": "Authorization",
            "value": "Bearer {{map_service_token}}"
          }
        ],
        "url": "{{base_url}}/internal/v1/users/{{user_id}}/relationships"
      }
    },
    {
      "name": "Internal: users batch",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('two users', () => pm.expect(pm.response.json().users).to.have.length(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{map_service_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/internal/v1/users/batch",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_ids\": [\n    \"{{user_id}}\",\n    \"{{bob_id}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Internal: battle settlement",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('winner credited 50', () => pm.expect(pm.response.json().entries[0].delta).to.eql(50));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{battle_service_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/internal/v1/wallets/settlements",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operation_id\": \"{{$guid}}\",\n  \"source_kind\": \"battle\",\n  \"source_id\": \"{{$guid}}\",\n  \"winner_id\": \"{{user_id}}\",\n  \"loser_id\": \"{{carol_id}}\",\n  \"recipient_ids\": [\n    \"{{user_id}}\"\n  ],\n  \"reward_per_recipient\": 50,\n  \"loser_penalty\": 20,\n  \"rules_version\": 1,\n  \"definition_id\": null,\n  \"definition_version\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
