    {
      "name": "Login (seeded Alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const tokens = pm.response.json();",
              "pm.test('bearer tokens', () => pm.expect(tokens.token_type).to.eql('Bearer'));",
              "pm.collectionVariables.set('access_token', tokens.access_token);",
              "pm.collectionVariables.set('refresh_token', tokens.refresh_token);",
              "const claimsOf = (token) => { const part = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  return JSON.parse(CryptoJS.enc.Base64.parse(part + '='.repeat((4 - part.length % 4) % 4)).toString(CryptoJS.enc.Utf8)); };",
              "pm.test('no roles for an ordinary user', () => pm.expect(claimsOf(tokens.access_token).roles).to.eql([]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
