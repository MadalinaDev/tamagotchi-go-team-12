    {
      "name": "Internal: a user token is refused (gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('refused by the gateway', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
