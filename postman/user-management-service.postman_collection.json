{
  "info": {
    "name": "User Management Lab 1 regression suite",
    "description": "Every User Management endpoint against the seeded data (AUTH_MODE=mock: X-Mock-User-Id / X-Service-Name). Seed users: Alice (user_id), Bob and Carol; password password123. Safe to run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('user_management_base_url')) pm.collectionVariables.set('base_url', pm.environment.get('user_management_base_url'));",
          "pm.collectionVariables.set('now', new Date().toISOString());"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8085"
    },
    {
      "key": "user_id",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "bob_id",
      "value": "00000000-0000-4000-8000-000000000002"
    },
    {
      "key": "carol_id",
      "value": "00000000-0000-4000-8000-000000000003"
    },
    {
      "key": "package_a",
      "value": "00000000-0000-4000-8000-0000000000a1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Missing auth is 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('error code UNAUTHENTICATED', () => pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/users/me"
      }
    },
    {
      "name": "Get me (Alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('alice', () => pm.expect(pm.response.json().username).to.eql('alice'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Mock-User-Id",
            "value": "{{user_id}}"
          }
        ],
        "url": "{{base_url}}/api/v1/users/me"
      }
    },
    {
      "name": "Register user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('new_username', 'user' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const user = pm.response.json();",
              "pm.test('no password in response', () => pm.expect(user).to.not.have.property('password'));",
              "pm.collectionVariables.set('new_user_id', user.user_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{new_username}}\",\n  \"email\": \"{{new_username}}@example.com\",\n  \"password\": \"correct-horse-1\",\n  \"display_name\": \"New user\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Register with unknown field is 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test('is_admin rejected', () => pm.expect(pm.response.json().details.map(d => d.field)).to.include('is_admin'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"mallory1\",\n  \"email\": \"mallory1@example.com\",\n  \"password\": \"correct-horse-1\",\n  \"display_name\": \"M\",\n  \"is_admin\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Login (seeded Alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const tokens = pm.response.json();",
              "pm.test('bearer tokens', () => pm.expect(tokens.token_type).to.eql('Bearer'));",
              "pm.collectionVariables.set('access_token', tokens.access_token);",
              "pm.collectionVariables.set('refresh_token', tokens.refresh_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
