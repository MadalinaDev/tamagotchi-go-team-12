      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "broker_url",
      "value": "http://localhost:8090"
    },
    {
      "key": "discovery_url",
      "value": "http://localhost:8089"
    },
    {
      "key": "prometheus_url",
      "value": "http://localhost:9090"
    },
    {
      "key": "grafana_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "admin_email",
      "value": "admin@example.com"
    },
    {
      "key": "alice_email",
      "value": "alice@example.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "broker_admin_token",
      "value": ""
    },
    {
      "key": "map_service_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
