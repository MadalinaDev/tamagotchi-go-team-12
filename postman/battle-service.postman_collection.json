{"info":{"_postman_id":"b4ttle-service-lab1","name":"battle-service (Lab 1)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"CRUD verification for Sava's battle-service. Set base_url and user ids in collection variables, then run top to bottom."},"variable":[{"key":"base_url","value":"http://localhost:8081"},{"key":"user_id","value":"11111111-1111-4111-8111-111111111111"},{"key":"opponent_id","value":"22222222-2222-4222-8222-222222222222"},{"key":"primary_pet_id","value":"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"},{"key":"secondary_pet_id","value":"bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"},{"key":"battle_id","value":""}],"item":[{"name":"Health","request":{"method":"GET","url":"{{base_url}}/health"}},{"name":"Battle rules","request":{"method":"GET","url":"{{base_url}}/api/v1/battle-rules"}},{"name":"Create battle","event":[{"listen":"test","script":{"exec":["pm.test('created', function () {","  pm.response.to.have.status(201);","  var body = pm.response.json();","  pm.collectionVariables.set('battle_id', body.battle_id);","});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/battles","body":{"mode":"raw","raw":"{\n  \"opponent_id\": \"{{opponent_id}}\",\n  \"loadout\": {\n    \"primary_pet_id\": \"{{primary_pet_id}}\",\n    \"secondary_pet_id\": \"{{secondary_pet_id}}\",\n    \"boost\": \"power\"\n  }\n}"}}},{"name":"List battles","request":{"method":"GET","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/battles"}},{"name":"Get battle","request":{"method":"GET","header":[{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/battles/{{battle_id}}"}},{"name":"Update battle loadout","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-User-ID","value":"{{user_id}}"}],"url":"{{base_url}}/api/v1/battles/{{battle_id}}","body":{"mod