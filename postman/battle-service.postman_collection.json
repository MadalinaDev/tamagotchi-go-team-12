{
  "info": {
    "_postman_id": "c6a2ac7b-29a7-4fbb-8078-ac0672662e45",
    "name": "Battle Lab 1 regression suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key":"base_url","value":"http://localhost:8081"}],
  "event": [
    {"listen":"prerequest","script":{"type":"text/javascript","exec":[
      "if (pm.info.requestName === 'Health') { ['user_id','opponent_id','primary_pet_id','secondary_pet_id'].forEach(k => pm.collectionVariables.set(k, pm.variables.replaceIn('{{$guid}}'))); }",
      "pm.request.headers.upsert({key:'Content-Type',value:'application/json'});",
      "if (pm.info.requestName !== 'Missing identity') pm.request.headers.upsert({key:'X-User-ID',value:pm.collectionVariables.get(pm.info.requestName === 'Foreign owner' ? 'primary_pet_id' : 'user_id')});"
    ]}},
    {"listen":"test","script":{"type":"text/javascript","exec":[
      "const expected = {'Health':200,'Rules':200,'Create':201,'List':200,'Get':200,'Update':200,'Stale update':409,'Foreign owner':403,'Invalid ID':422,'Missing identity':401,'Trailing JSON':400,'Delete':204,'Get deleted':404};",
      "pm.test(pm.info.requestName + ' status', () => pm.response.to.have.status(expected[pm.info.requestName]));",
      "pm.test('Request ID returned', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.match(/^[a-f0-9-]{36}$/));",
      "if (pm.response.code !== 204) { const b=pm.response.json(); if (pm.info.requestName === 'Create') { pm.collectionVariables.set('battle_id',b.battle_id); pm.test('Persisted initial state',()=>{pm.expect(b.state).to.eql('pending');pm.expect(b.version).to.eql(1);pm.expect(b.challenger_id).to.eql(pm.collectionVariables.get('user_id'));}); }",
      "if(pm.info.requestName === 'Get') pm.test('Read created record',()=>pm.expect(b.battle_id).to.eql(pm.collectionVariables.get('battle_id')));",
      "if(pm.info.requestName === 'List') pm.test('List contains new record',()=>pm.expect(b.items.map(x=>x.battle_id)).to.include(pm.collectionVariables.get('battle_id')));",
      "if(pm.info.requestName === 'Update') pm.test('Version advanced',()=>{pm.expect(b.version).to.eql(2);pm.expect(b.loadout.boost).to.eql('guard');});",
      "if(pm.response.code>=400) pm.test('Structured error',()=>{pm.expect(b.request_id).to.eql(pm.response.headers.get('X-Request-ID'));pm.expect(b.code).to.be.a('string');pm.expect(b.details).to.be.an('array');}); }"
    ]}}
  ],
  "item": [
    {"name":"Health","request":{"method":"GET","url":"{{base_url}}/health"}},
    {"name":"Rules","request":{"method":"GET","url":"{{base_url}}/api/v1/battle-rules"}},
    {"name":"Create","request":{"method":"POST","url":"{{base_url}}/api/v1/battles","body":{"mode":"raw","raw":"{\"opponent_id\":\"{{opponent_id}}\",\"loadout\":{\"primary_pet_id\":\"{{primary_pet_id}}\",\"secondary_pet_id\":\"{{secondary_pet_id}}\",\"boost\":\"power\"}}"}}},
    {"name":"List","request":{"method":"GET","url":"{{base_url}}/api/v1/battles"}},
    {"name":"Get","request":{"method":"GET","url":"{{base_url}}/api/v1/battles/{{battle_id}}"}},
    {"name":"Update","request":{"method":"PATCH","url":"{{base_url}}/api/v1/battles/{{battle_id}}","body":{"mode":"raw","raw":"{\"loadout\":{\"primary_pet_id\":\"{{primary_pet_id}}\",\"secondary_pet_id\":\"{{secondary_pet_id}}\",\"boost\":\"guard\"},\"expected_version\":1}"}}},
    {"name":"Stale update","request":{"method":"PATCH","url":"{{base_url}}/api/v1/battles/{{battle_id}}","body":{"mode":"raw","raw":"{\"loadout\":{\"primary_pet_id\":\"{{primary_pet_id}}\",\"secondary_pet_id\":\"{{secondary_pet_id}}\",\"boost\":\"guard\"},\"expected_version\":1}"}}},
    {"name":"Foreign owner","request":{"method":"GET","url":"{{base_url}}/api/v1/battles/{{battle_id}}"}},
    {"name":"Invalid ID","request":{"method":"GET","url":"{{base_url}}/api/v1/battles/not-a-uuid"}},
    {"name":"Missing identity","request":{"method":"GET","url":"{{base_url}}/api/v1/battles"}},
    {"name":"Trailing JSON","request":{"method":"POST","url":"{{base_url}}/api/v1/battles","body":{"mode":"raw","raw":"{} {}"}}},
    {"name":"Delete","request":{"method":"DELETE","url":"{{base_url}}/api/v1/battles/{{battle_id}}"}},
    {"name":"Get deleted","request":{"method":"GET","url":"{{base_url}}/api/v1/battles/{{battle_id}}"}}
  ]
}
