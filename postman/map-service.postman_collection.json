{
  "info": {
    "name": "Map Lab 2 regression suite (through the gateway)",
    "description": "Every Map REST endpoint, called through the gateway (gateway_base_url, default http://localhost:8080) with Alice's, Bob's and Carol's bearer tokens, logged in before the first request. Map asks the real User Management (through the gateway) for relationships: Alice and Bob are friends, Carol has marked Bob as an enemy. The SSE route GET /api/v1/map/stream never ends, so it is checked with curl -N instead (see the Map README). Safe to run repeatedly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('gateway_base_url')) pm.collectionVariables.set('base_url', pm.environment.get('gateway_base_url'));",
          "pm.collectionVariables.set('now', new Date().toISOString());",
          "// Each run logs the three seed users in again through the gateway before its first request.",
          "if (pm.info.requestName === 'Health (gateway)') ['alice_token', 'bob_token', 'carol_token'].forEach((key) => pm.collectionVariables.unset(key));",
          "const login = (name) => pm.sendRequest({ url: pm.collectionVariables.get('base_url') + '/api/v1/auth/login', method: 'POST', header: { 'Content-Type': 'application/json' },",
          "  body: { mode: 'raw', raw: JSON.stringify({ email: name + '@example.com', password: pm.collectionVariables.get('demo_password') }) } },",
          "  (err, res) => { if (!err && res.code === 200) pm.collectionVariables.set(name + '_token', res.json().access_token); else console.warn(name + ' login failed', err || res.code); });",
          "['alice', 'bob', 'carol'].forEach((name) => { if (!pm.collectionVariables.get(name + '_token')) login(name); });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "demo_password",
      "value": "password123"
    },
    {
      "key": "alice_token",
      "value": ""
    },
    {
      "key": "bob_token",
      "value": ""
    },
    {
      "key": "carol_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "bob_id",
      "value": "00000000-0000-4000-8000-000000000002"
    },
    {
      "key": "carol_id",
      "value": "00000000-0000-4000-8000-000000000003"
    }
  ],
  "item": [
    {
      "name": "Health (gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('gateway ok', () => pm.expect(pm.response.json()).to.include({ status: 'ok', service: 'gateway' }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Missing access token is 401 (gateway)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 401', () => pm.response.to.have.status(401));",
              "pm.test('refused by the gateway', () => pm.expect(pm.response.json().code).to.eql('UNAUTHORIZED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/map/users"
      }
    },
    {
      "name": "Share location (Alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8638000,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{now}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Share location (Bob, 1 km away)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{bob_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8769743,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{now}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Share location (Carol, 3 m from Alice)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('accepted', () => pm.expect(pm.response.json().accepted).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{carol_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8638395,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{now}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Visible users for Alice",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const users = Object.fromEntries(pm.response.json().users.map(u => [u.user.user_id, u]));",
              "pm.test('Bob is a friend at any distance', () => pm.expect(users[pm.collectionVariables.get('bob_id')].relationship).to.eql('friend'));",
              "pm.test('Carol is a nearby stranger', () => { const c = users[pm.collectionVariables.get('carol_id')]; pm.expect(c.relationship).to.eql('unknown'); pm.expect(c.distance_m).to.be.below(6); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/map/users"
      }
    },
    {
      "name": "Visible users for Carol",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const users = Object.fromEntries(pm.response.json().users.map(u => [u.user.user_id, u]));",
              "pm.test('Bob is an enemy', () => pm.expect(users[pm.collectionVariables.get('bob_id')].relationship).to.eql('enemy'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{carol_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/map/users"
      }
    },
    {
      "name": "Older update is not applied",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('older', new Date(Date.now() - 60000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('accepted false', () => pm.expect(pm.response.json().accepted).to.be.false);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8644587,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{older}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Invalid latitude is 422",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test('error code VALIDATION_FAILED', () => pm.expect(pm.response.json().code).to.eql('VALIDATION_FAILED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 120,\n  \"longitude\": 28.8638,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{now}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Stale timestamp is 422",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('stale', new Date(Date.now() - 600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 422', () => pm.response.to.have.status(422));",
              "pm.test('error code INVALID_RECORDED_AT', () => pm.expect(pm.response.json().code).to.eql('INVALID_RECORDED_AT'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8638000,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{stale}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Stop sharing (Carol)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{carol_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{base_url}}/api/v1/map/location"
      }
    },
    {
      "name": "Carol is no longer visible",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('Carol gone', () => pm.expect(pm.response.json().users.map(u => u.user.user_id)).to.not.include(pm.collectionVariables.get('carol_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{alice_token}}"
          }
        ],
        "url": "{{base_url}}/api/v1/map/users"
      }
    }
  ]
}
