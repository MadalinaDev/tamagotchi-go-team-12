{
  "info": {
    "name": "guild-service",
    "description": "Guild service (Vica), Lab 1. Run the whole collection in order with the Collection Runner: it creates a guild as Alice ({{user_id}}), invites Bob, chats, exercises every endpoint and finally disbands the guild. Auth is mocked: X-Mock-User-Id selects the caller. Internal routes only need X-Service-Name. User Management and Package Registry are mocked (Alice and Bob are friends and share package A; Carol is not Alice's friend).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Guilds",
      "item": [
        {
          "name": "Create guild (Alice becomes leader)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Mock-User-Id",
                "value": "{{user_id}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guilds",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "guilds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Founders {{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"guild_id\", pm.response.json().guild_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List guilds",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Mock-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guilds?limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "guilds"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
