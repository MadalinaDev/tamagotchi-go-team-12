{
  "info": {
    "name": "guild-service",
    "description": "Guild service (Vica), Lab 1. Runs against the seeded data (SEED_ON_START=true): guild Founders {{founders_guild_id}} with leader Alice ({{user_id}}) and members Bob and Carol. Run the whole collection in order with the Collection Runner; it leaves the seeded state as it found it, so it can be re-run. Auth is mocked: X-Mock-User-Id selects the caller. Internal routes only need X-Service-Name. User Management and Package Registry are mocked: Alice and Bob are friends and share package A; Carol and the admin user have no friends.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Seeded guild (Founders)",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Mock-User-Id",
                "value": "{{user_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
