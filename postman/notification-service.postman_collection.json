              "path": [
                "internal",
                "v1",
                "dev",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{event_id}}\",\n  \"type\": \"GuildInvited\",\n  \"version\": 1,\n  \"producer\": \"guild\",\n  \"occurred_at\": \"2026-10-09T12:00:00Z\",\n  \"correlation_id\": \"{{$guid}}\",\n  \"payload\": {\n    \"invite_id\": \"{{$guid}}\",\n    \"guild_id\": \"{{founders_guild_id}}\",\n    \"inviter_id\": \"{{bob_id}}\",\n    \"invitee_id\": \"{{alice_id}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
