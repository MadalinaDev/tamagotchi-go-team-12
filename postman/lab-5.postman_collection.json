    {
      "name": "Grade 7 - consistent hashing",
      "description": "Every key has a position on a 64-bit ring (MD5); every node owns 160 virtual points. docs/lab-5-consistent-hashing.md compares it with hash % N and Redis Cluster's slots.",
      "item": [
        {
          "name": "Where a key lives",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/cache/locate?key=auth:jwks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('one of the three nodes', () => pm.expect(pm.response.json().node).to.match(/^cache-[123]$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulation: add a fourth node",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/cache/simulation?keys=10000&add=cache-4"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('the ring moves about 1/4 of the keys', () => pm.expect(s.consistent_hashing.moved.percent).to.be.within(15, 35));",
                  "pm.test('hash % N moves about 3/4', () => pm.expect(s.modulo.moved.percent).to.be.above(60));",
                  "pm.test('Redis Cluster moves about 1/4 too (whole slots)', () => pm.expect(s.redis_cluster_slots.moved.percent).to.be.within(15, 35));",
                  "pm.test('virtual nodes keep the shares even', () => pm.expect(s.consistent_hashing.imbalance_percent).to.be.below(s.consistent_hashing.imbalance_percent_with_1_point_per_node));"
                ]
              }
            }
          ]
        },
        {
          "name": "Simulation: remove cache-2",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/cache/simulation?keys=10000&remove=cache-2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test('only cache-2 keys move (about 1/3)', () => pm.expect(s.consistent_hashing.moved.percent).to.be.within(20, 45));",
                  "pm.test('hash % N moves most keys', () => pm.expect(s.modulo.moved.percent).to.be.above(50));"
                ]
              }
            }
