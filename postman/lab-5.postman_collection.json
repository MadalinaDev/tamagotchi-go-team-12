    {
      "name": "Grade 9 - account deletion saga",
      "description": "DELETE /api/v1/users/me starts a saga the broker coordinates across User Management and Map: deactivate -> hide -> erase (pivot) -> purge. A refused step undoes the earlier ones in reverse (reactivate, unhide).",
      "item": [
        {
          "name": "Register a player to delete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{doomed_username}}\",\n  \"email\": \"{{doomed_email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Doomed player\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36);",
                  "pm.collectionVariables.set('doomed_username', `doomed_${suffix}`);",
                  "pm.collectionVariables.set('doomed_email', `doomed_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('doomed_id', pm.response.json().user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "The player logs in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doomed_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('doomed_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "The player shares a location (Map has data about them)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doomed_token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/map/location",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 47.0105,\n  \"longitude\": 28.8638,\n  \"accuracy_m\": 5,\n  \"recorded_at\": \"{{now}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('now', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete my account -> 202, the saga starts",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doomed_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));",
                  "const saga = pm.response.json();",
                  "pm.collectionVariables.set('saga_id', saga.saga_id);",
                  "pm.test('an account-deletion saga about this player', () => {",
                  "  pm.expect(saga.type).to.eql('account-deletion');",
                  "  pm.expect(saga.subject).to.eql(pm.collectionVariables.get('doomed_id'));",
                  "  pm.expect(saga.steps.map((s) => s.name)).to.eql(['deactivate-account', 'hide-from-map', 'erase-account', 'purge-map-data']);",
                  "  pm.expect(saga.steps.map((s) => s.kind)).to.eql(['compensatable', 'compensatable', 'pivot', 'retriable']);",
                  "});",
                  "pm.test('Location: /api/v1/sagas/{id}', () => pm.expect(pm.response.headers.get('Location')).to.eql(`/api/v1/sagas/${saga.saga_id}`));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for the saga to complete (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/sagas/{{saga_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tries = Number(pm.collectionVariables.get('saga_polls') || 0) + 1;",
                  "const saga = pm.response.json();",
                  "if (!(saga.status === 'completed' || saga.status === 'failed' || saga.status === 'compensated') && tries < 40) {",
                  "  pm.collectionVariables.set('saga_polls', tries);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('saga_polls', 0);",
                  "pm.test('completed', () => pm.expect(saga.status).to.eql('completed'));",
                  "pm.test('every step succeeded, on a replica of its service', () => {",
                  "  saga.steps.forEach((step) => {",
                  "    pm.expect(step.status).to.eql('succeeded');",
                  "    pm.expect(step.replica).to.be.a('string');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "The deleted player is locked out -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doomed_token}}"
