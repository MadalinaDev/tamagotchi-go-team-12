    {
      "name": "Grade 5 - replication and failover",
      "description": "Patroni: pg-1, pg-2, pg-3, one leader and two streaming replicas (one synchronous), the leader lock in etcd. The router `postgres` sends 5432 to the leader and 5433 to the replicas. Failover: docker compose stop <leader> (see docs/lab-5-demo.md).",
      "item": [
        {
          "name": "The cluster (Patroni REST API)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{patroni_url}}/cluster"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const members = pm.response.json().members;",
                  "const leader = members.filter((m) => m.role === 'leader');",
                  "const replicas = members.filter((m) => m.role !== 'leader');",
                  "pm.test('three nodes, one leader', () => {",
                  "  pm.expect(members.length).to.eql(3);",
                  "  pm.expect(leader.length).to.eql(1);",
                  "});",
                  "pm.test('two replicas streaming from it, one synchronous', () => {",
                  "  pm.expect(replicas.length).to.eql(2);",
                  "  replicas.forEach((m) => pm.expect(m.state).to.eql('streaming'));",
                  "  pm.expect(members.filter((m) => m.role === 'sync_standby').length).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set('leader', leader[0].name);",
                  "console.log(`leader: ${leader[0].name} (stop it to fail over)`);"
                ]
              }
            }
          ]
        },
        {
          "name": "The router (HAProxy): 5432 -> the leader, 5433 -> the replicas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{haproxy_url}}/;csv"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.text().split('\\n').map((line) => line.split(','));",
                  "const up = (proxy) => rows.filter((r) => r[0] === proxy && /^pg-/.test(r[1]) && r[17] === 'UP').map((r) => r[1]);",
                  "pm.test('one server behind the primary port: the leader', () => {",
                  "  pm.expect(up('primary')).to.eql([pm.collectionVariables.get('leader')]);",
                  "});",
                  "pm.test('two servers behind the replica port', () => pm.expect(up('replicas').length).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Grade 6 - caching",
      "description": "The gateway caches common GETs (per user, or shared for definitions) and verified tokens on three Redis nodes; a write to a service makes that service's cached answers stale.",
      "item": [
        {
          "name": "Empty the cache (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/admin/cache"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('every node flushed', () => pm.expect(pm.response.json().flushed).to.eql({ 'cache-1': true, 'cache-2': true, 'cache-3': true }));"
                ]
              }
            }
          ]
        },
