                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('ghost_saga_id', pm.response.json().saga_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "...User Management refuses the first step: the saga is compensated",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{broker_admin_token}}"
              }
            ],
            "url": "{{broker_url}}/v1/sagas/{{ghost_saga_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 500);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tries = Number(pm.collectionVariables.get('ghost_polls') || 0) + 1;",
                  "const saga = pm.response.json();",
                  "if (!(saga.status !== 'running' && saga.status !== 'compensating') && tries < 40) {",
                  "  pm.collectionVariables.set('ghost_polls', tries);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.collectionVariables.set('ghost_polls', 0);",
                  "pm.test('compensated', () => pm.expect(saga.status).to.eql('compensated'));",
                  "pm.test('the refusal is recorded', () => {",
                  "  pm.expect(saga.steps[0].status).to.eql('failed');",
                  "  pm.expect(saga.last_error).to.include('404');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A service cannot call a saga step through the broker -> 404",
