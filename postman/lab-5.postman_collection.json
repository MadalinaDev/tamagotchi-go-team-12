{
  "info": {
    "name": "Lab 5 - sharding and replication",
    "description": "Lab 5 grade by grade (docs/lab-5-conventions.md, demo: docs/lab-5-demo.md). Start the stack (docker compose up -d --wait), then set etl_admin_token, broker_admin_token and map_service_token from .env (ETL_ADMIN_TOKEN, BROKER_ADMIN_TOKEN, MAP_SERVICE_TOKEN; newman: --env-var etl_admin_token=... and so on).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "description": "Log in the seeded admin and Alice.",
      "item": [
        {
          "name": "Log in the admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway_url}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
